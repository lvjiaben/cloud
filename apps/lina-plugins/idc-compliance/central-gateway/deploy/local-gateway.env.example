# LinaPro IDC local compliance gateway process settings.
# Copy this template into the installation's private configuration directory.
# Never place database credentials, HMAC keys, TLS private keys, or supplier
# credentials directly in this file; the variables below point to secret files.

LINAPRO_COMPLIANCE_GATEWAY_LISTEN_ADDR=127.0.0.1:9088
# Read by the colocated LinaPro source plugin; loopback-only and fixed.
LINAPRO_COMPLIANCE_GATEWAY_INTERNAL_BASE_URL=http://127.0.0.1:9088
LINAPRO_COMPLIANCE_GATEWAY_READ_HEADER_TIMEOUT=5s
LINAPRO_COMPLIANCE_GATEWAY_READ_TIMEOUT=10s
LINAPRO_COMPLIANCE_GATEWAY_WRITE_TIMEOUT=10s
LINAPRO_COMPLIANCE_GATEWAY_IDLE_TIMEOUT=30s
LINAPRO_COMPLIANCE_GATEWAY_SHUTDOWN_TIMEOUT=10s

# All values are absolute paths to private files owned by this installation.
# The DSN file contains one PostgreSQL connection string. Generate the process
# supplier-identity, and callback-evidence keyrings with their bundled commands;
# never reuse them between installations or between purposes.
LINAPRO_COMPLIANCE_GATEWAY_DATABASE_DSN_FILE=/etc/linapro/idc-compliance/database.dsn
LINAPRO_COMPLIANCE_GATEWAY_INSTALLATION_ID_FILE=/etc/linapro/idc-compliance/installation-id
LINAPRO_COMPLIANCE_GATEWAY_PROCESS_AUTH_KEYRING_FILE=/etc/linapro/idc-compliance/process-auth-keyring.json
LINAPRO_COMPLIANCE_GATEWAY_SUPPLIER_IDENTITY_KEYRING_FILE=/etc/linapro/idc-compliance/supplier-identity-keyring.json
LINAPRO_COMPLIANCE_GATEWAY_CALLBACK_EVIDENCE_KEYRING_FILE=/etc/linapro/idc-compliance/callback-evidence-keyring.json
LINAPRO_COMPLIANCE_GATEWAY_PROCESS_AUTH_WINDOW=60s

# Optional Tencent eSign client owned by this buyer installation. Copy the JSON
# example into the private secret directory, replace every placeholder there,
# grant access only to the gateway service account, and set its absolute path.
# Leave this unset to keep every Tencent ability disabled. There is no custom
# endpoint, central fallback, or browser-submitted credential setting.
# LINAPRO_COMPLIANCE_GATEWAY_TENCENT_ESSBASIC_CONFIG_FILE=/etc/linapro/idc-compliance/tencent-essbasic.json

# Tencent capabilities are enabled only by the private file and their runtime
# checks. Nuonuo and any missing supplier capability remain disabled.
