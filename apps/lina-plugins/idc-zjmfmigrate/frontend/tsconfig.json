{
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2023",
      "DOM.Iterable"
    ],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "src/**/*.test.ts"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
