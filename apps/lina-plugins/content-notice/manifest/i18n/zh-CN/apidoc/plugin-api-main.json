{
  "plugins": {
    "content_notice": {
      "api": {
        "notice": {
          "v1": {
            "DeleteReq": {
              "meta": {
                "dc": "使用查询数组ids[]删除一条或多条公告",
                "summary": "删除公告",
                "tags": "公告"
              },
              "fields": {
                "ids": {
                  "dc": "公告编号列表，使用查询数组，例如ids[]=1&ids[]=2&ids[]=3"
                }
              }
            },
            "ListReq": {
              "meta": {
                "dc": "按页查询公告，支持标题及创建人筛选。",
                "summary": "获取公告列表",
                "tags": "公告"
              },
              "fields": {
                "pageNum": {
                  "dc": "页码"
                },
                "pageSize": {
                  "dc": "每页条数"
                },
                "title": {
                  "dc": "按标题模糊筛选"
                },
                "createdBy": {
                  "dc": "按创建人用户名筛选"
                }
              }
            },
            "ListRes": {
              "fields": {
                "list": {
                  "dc": "公告列表"
                },
                "total": {
                  "dc": "总条数"
                }
              }
            },
            "ListItem": {
              "fields": {
                "createdByName": {
                  "dc": "创建人用户名"
                }
              }
            },
            "NoticeItem": {
              "fields": {
                "id": {
                  "dc": "公告编号"
                },
                "title": {
                  "dc": "公告标题"
                },
                "content": {
                  "dc": "公告正文，支持富文本HTML"
                },
                "sortOrder": {
                  "dc": "排序值，数值越小越靠前"
                },
                "status": {
                  "dc": "公告状态：0=草稿，1=已发布"
                },
                "createdBy": {
                  "dc": "创建人用户编号"
                },
                "updatedBy": {
                  "dc": "最后修改人用户编号"
                },
                "createdAt": {
                  "dc": "创建时间，Unix毫秒时间戳"
                },
                "updatedAt": {
                  "dc": "最后修改时间，Unix毫秒时间戳"
                }
              }
            },
            "UpdateReq": {
              "meta": {
                "dc": "修改指定公告，所有字段均可按需更新。",
                "summary": "修改公告",
                "tags": "公告"
              },
              "fields": {
                "id": {
                  "dc": "公告编号"
                },
                "title": {
                  "dc": "公告标题"
                },
                "content": {
                  "dc": "公告正文，支持富文本HTML"
                },
                "sortOrder": {
                  "dc": "排序值，数值越小越靠前"
                },
                "status": {
                  "dc": "公告状态：0=草稿，1=已发布"
                }
              }
            },
            "GetReq": {
              "meta": {
                "dc": "根据编号获取公告正文及创建人信息。",
                "summary": "获取公告详情",
                "tags": "公告"
              },
              "fields": {
                "id": {
                  "dc": "公告编号"
                }
              }
            },
            "GetRes": {
              "fields": {
                "createdByName": {
                  "dc": "创建人用户名"
                }
              }
            },
            "CreateReq": {
              "meta": {
                "dc": "创建草稿或已发布公告，正文支持图片。",
                "summary": "新增公告",
                "tags": "公告"
              },
              "fields": {
                "title": {
                  "dc": "公告标题"
                },
                "content": {
                  "dc": "公告正文，支持富文本HTML"
                },
                "sortOrder": {
                  "dc": "排序值，数值越小越靠前"
                },
                "status": {
                  "dc": "公告状态：0=草稿，1=已发布"
                }
              }
            },
            "CreateRes": {
              "fields": {
                "id": {
                  "dc": "公告编号"
                }
              }
            },
            "AnnouncementItem": {
              "fields": {
                "id": {
                  "dc": "公告编号"
                },
                "title": {
                  "dc": "公告标题"
                },
                "content": {
                  "dc": "公告正文，包含正文图片"
                },
                "sortOrder": {
                  "dc": "排序值，数值越小越靠前"
                },
                "createdAt": {
                  "dc": "创建时间，Unix毫秒时间戳"
                },
                "updatedAt": {
                  "dc": "最后修改时间，Unix毫秒时间戳"
                },
                "read": {
                  "dc": "当前用户是否已读该公告"
                }
              }
            },
            "AnnouncementsReq": {
              "meta": {
                "dc": "列出全部已发布公告及当前用户的阅读状态。",
                "summary": "获取已发布公告列表",
                "tags": "公告"
              },
              "fields": {
                "pageNum": {
                  "dc": "页码"
                },
                "pageSize": {
                  "dc": "每页条数"
                }
              }
            },
            "AnnouncementsRes": {
              "fields": {
                "list": {
                  "dc": "已发布公告"
                },
                "total": {
                  "dc": "总条数"
                }
              }
            },
            "AnnouncementReq": {
              "meta": {
                "dc": "获取已发布公告及当前用户的阅读状态。",
                "summary": "获取已发布公告",
                "tags": "公告"
              },
              "fields": {
                "id": {
                  "dc": "公告编号"
                }
              }
            },
            "AnnouncementReadReq": {
              "meta": {
                "dc": "为当前登录用户幂等标记公告已读。",
                "summary": "标记公告已读",
                "tags": "公告"
              },
              "fields": {
                "id": {
                  "dc": "公告编号"
                }
              }
            }
          }
        },
        "publicnotice": {
          "v1": {
            "Item": {
              "fields": {
                "id": {
                  "dc": "公告编号"
                },
                "title": {
                  "dc": "公告标题"
                },
                "content": {
                  "dc": "公告正文，包含正文图片"
                },
                "sortOrder": {
                  "dc": "排序值，数值越小越靠前"
                },
                "createdAt": {
                  "dc": "创建时间，Unix毫秒时间戳"
                },
                "updatedAt": {
                  "dc": "最后修改时间，Unix毫秒时间戳"
                }
              }
            },
            "ListReq": {
              "meta": {
                "dc": "列出官网已发布公告。",
                "summary": "获取官网公告列表",
                "tags": "公告"
              },
              "fields": {
                "pageNum": {
                  "dc": "页码"
                },
                "pageSize": {
                  "dc": "每页条数"
                }
              }
            },
            "ListRes": {
              "fields": {
                "list": {
                  "dc": "已发布公告"
                },
                "total": {
                  "dc": "总条数"
                }
              }
            },
            "GetReq": {
              "meta": {
                "dc": "获取官网已发布公告。",
                "summary": "获取官网公告",
                "tags": "公告"
              },
              "fields": {
                "id": {
                  "dc": "公告编号"
                }
              }
            }
          }
        }
      }
    }
  }
}
