{
  "name": "@vben-core/shared",
  "version": "5.6.0",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/@vben-core/base/shared"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./constants": {
      "types": "./src/constants/index.ts",
      "development": "./src/constants/index.ts",
      "default": "./src/constants/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "development": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./color": {
      "types": "./src/color/index.ts",
      "development": "./src/color/index.ts",
      "default": "./src/color/index.ts"
    },
    "./cache": {
      "types": "./src/cache/index.ts",
      "development": "./src/cache/index.ts",
      "default": "./src/cache/index.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "development": "./src/store.ts",
      "default": "./src/store.ts"
    },
    "./global-state": {
      "types": "./src/global-state.ts",
      "development": "./src/global-state.ts",
      "default": "./src/global-state.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./constants": {
        "types": "./dist/constants/index.d.ts",
        "default": "./dist/constants/index.mjs"
      },
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.mjs"
      },
      "./color": {
        "types": "./dist/color/index.d.ts",
        "default": "./dist/color/index.mjs"
      },
      "./cache": {
        "types": "./dist/cache/index.d.ts",
        "default": "./dist/cache/index.mjs"
      },
      "./store": {
        "types": "./dist/store.d.ts",
        "default": "./dist/store.mjs"
      },
      "./global-state": {
        "types": "./dist/global-state.d.ts",
        "default": "./dist/global-state.mjs"
      }
    }
  },
  "dependencies": {
    "@ctrl/tinycolor": "4.2.0",
    "@tanstack/vue-store": "0.9.1",
    "@vue/shared": "3.5.43",
    "clsx": "2.1.1",
    "dayjs": "1.11.19",
    "defu": "6.1.7",
    "es-toolkit": "1.45.1",
    "lodash.clonedeep": "4.5.0",
    "nprogress": "0.2.0",
    "tailwind-merge": "3.5.0",
    "theme-colors": "0.1.0"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "4.5.9",
    "@types/nprogress": "0.2.3"
  }
}
