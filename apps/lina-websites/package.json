{
  "name": "@lina/websites-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:default": "pnpm --filter @lina/site-default build",
    "build:sdk": "pnpm --filter @lina/site-sdk... build",
    "dev": "pnpm --filter @lina/site-default dev",
    "test:e2e": "pnpm --filter @lina/site-default test:e2e",
    "typecheck": "pnpm --filter @lina/site-sdk... build && pnpm -r --if-present typecheck"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
