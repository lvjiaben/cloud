    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lina/site-contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
