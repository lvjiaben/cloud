{
  "name": "@lina/site-sdk",
  "version": "0.1.0",
  "description": "Safe client for Lina public website APIs",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
