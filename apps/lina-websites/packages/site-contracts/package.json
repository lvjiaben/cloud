{
  "name": "@lina/site-contracts",
  "version": "0.1.0",
  "description": "Stable public contracts for independently developed Lina website packages",
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./site-package.schema.json": "./schema/site-package.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
