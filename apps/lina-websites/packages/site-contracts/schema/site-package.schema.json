{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linapro.ai/schemas/site-package-v1.json",
  "title": "Lina website package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "name",
    "publisher",
    "compatibility",
    "runtime",
    "locales",
    "routes",
    "capabilities",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "name": { "$ref": "#/$defs/localizedText" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisherId", "keyId", "signatureAlgorithm", "signature"],
      "properties": {
        "publisherId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 64
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "minLength": 3,
          "maxLength": 96
        },
        "signatureAlgorithm": { "const": "ed25519" },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteContract", "platformApi"],
      "properties": {
        "siteContract": { "const": "1.0" },
        "platformApi": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry", "publicAssets", "healthPath"],
      "properties": {
        "kind": { "const": "nuxt-node-1" },
        "entry": { "const": "server/index.mjs" },
        "publicAssets": { "const": "public" },
        "healthPath": { "const": "/__site/health" }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "contains": { "const": "zh-CN" },
      "items": { "enum": ["zh-CN", "en-US"] }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public"],
      "properties": {
        "public": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 160,
            "not": {
              "pattern": "^/(?:admin|api|x|x-assets|auth|account|cart|checkout)(?:/|$)"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$", "maxLength": 64 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 268435456 }
        }
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zhCN", "enUS"],
      "properties": {
        "zhCN": { "type": "string", "minLength": 1, "maxLength": 128 },
        "enUS": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
